# Copy to .env.local and fill in. NEVER commit .env.local. Never prefix with NEXT_PUBLIC_.

# --- Supabase (optional for localhost; without it data is kept in .data/store.json) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (AI news analysis; optional, news still works without it) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Eulerpool (optional, used by scripts/probe-eulerpool.mjs for now) ---
EULERPOOL_API_KEY=

# --- Protects /api/cron/*. Any long random string, e.g. `openssl rand -hex 32` ---
CRON_SECRET=dev-secret-change-me
